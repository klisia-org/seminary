 ],
 "fields": [
  {
   "fieldname": "post",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Post",
   "options": "Cohort Post",
   "reqd": 1,
   "search_index": 1
  },
  {
   "description": "The reply this one is nested under. Empty for a top-level reply.",
   "fieldname": "parent_comment",
   "fieldtype": "Link",
   "label": "Parent Comment",
   "options": "Cohort Post Comment",
   "search_index": 1
  },
  {
   "fieldname": "author",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Author",
   "options": "Person",
   "reqd": 1
  },
  {
   "fieldname": "column_break_head",
   "fieldtype": "Column Break"
  },
  {
   "default": "published",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "published\nblocked"
  },
  {
   "default": "0",
   "description": "A private reply is visible only to the post's author, its writer, and cohort leaders/staff.",
   "fieldname": "is_private",
   "fieldtype": "Check",
   "label": "Private reply"
  },
  {
   "default": "General",
   "fieldname": "anchor_type",
   "fieldtype": "Select",
   "label": "Anchor Type",
   "options": "General\nTimestamp\nVerseRange\nTextRange\nRegion"
  },
  {
   "fieldname": "content_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "content",
   "fieldtype": "Text Editor",
   "in_list_view": 1,
   "label": "Content",
   "reqd": 1
  },
  {
   "collapsible": 1,
   "depends_on": "eval: doc.anchor_type && doc.anchor_type !== 'General'",
   "fieldname": "anchor_section",
   "fieldtype": "Section Break",
   "label": "Anchor"
  },
  {
   "depends_on": "eval: doc.anchor_type === 'Timestamp'",
   "description": "Video position in seconds.",
   "fieldname": "timestamp_s",
   "fieldtype": "Int",
   "label": "Timestamp (s)",
   "non_negative": 1
  },
  {
   "depends_on": "eval: doc.anchor_type === 'VerseRange'",
   "description": "First verse of the range, as a canonical ordinal.",
   "fieldname": "verse_start_ord",
   "fieldtype": "Int",
   "label": "Verse Start Ordinal"
  },
  {
   "depends_on": "eval: doc.anchor_type === 'VerseRange'",
   "description": "Last verse of the range, as a canonical ordinal.",
   "fieldname": "verse_end_ord",
   "fieldtype": "Int",
   "label": "Verse End Ordinal"
  },
  {
   "depends_on": "eval: doc.anchor_type === 'VerseRange'",
   "description": "The passage this comment is anchored to, as typed.",
   "fieldname": "anchor_ref",
   "fieldtype": "Data",
   "label": "Anchor Reference",
   "read_only": 1
  },
  {
   "fieldname": "column_break_anchor",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval: doc.anchor_type === 'TextRange'",
   "fieldname": "range_from",
   "fieldtype": "Int",
   "label": "Range From"
  },
  {
   "depends_on": "eval: doc.anchor_type === 'TextRange'",
   "fieldname": "range_to",
   "fieldtype": "Int",
   "label": "Range To"
  },
  {
   "depends_on": "eval: doc.anchor_type === 'Region'",
   "fieldname": "page",
   "fieldtype": "Int",
   "label": "Page",
   "non_negative": 1
  },
  {
   "depends_on": "eval: doc.anchor_type === 'Region'",
   "fieldname": "x_pct",
   "fieldtype": "Float",
   "label": "X %"
  },
  {
   "depends_on": "eval: doc.anchor_type === 'Region'",
   "fieldname": "y_pct",
   "fieldtype": "Float",
   "label": "Y %"
  },
