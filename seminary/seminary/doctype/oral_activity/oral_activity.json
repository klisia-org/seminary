 "description": "Spoken activity an instructor sets up for a course: a recorded talk by one student, or a recorded conversation among a group. Create one for each graded oral activity.",
 "doctype": "DocType",
 "documentation": "https://docs.seminaryerp.org/modules/grading.html",
 "engine": "InnoDB",
 "field_order": [
  "title",
  "course",
  "mode",
  "column_break_main",
