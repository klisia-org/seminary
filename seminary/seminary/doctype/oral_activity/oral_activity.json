 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "reqd": 1
  },
  {
   "fieldname": "course",
   "fieldtype": "Link",
   "label": "Course",
   "options": "Course",
   "reqd": 1,
   "link_filters": "[[\"Course\",\"disabled\",\"=\",0]]",
   "description": "This allows the activity to be used in other offerings of the course."
  },
  {
   "default": "Individual",
   "fieldname": "mode",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Mode",
   "options": "Individual\nConversation",
   "description": "Individual: each student records alone. Conversation: a group records one conversation together."
  },
  {
   "fieldname": "column_break_main",
   "fieldtype": "Column Break"
  },
  {
   "default": "10",
   "fieldname": "max_minutes",
   "fieldtype": "Int",
   "label": "Maximum Length (minutes)",
   "non_negative": 1
  },
  {
   "default": "0",
   "fieldname": "allow_upload",
   "fieldtype": "Check",
   "label": "Allow Uploading a Recording",
   "description": "Students may upload a file recorded elsewhere, such as on a phone in a classroom, instead of recording in the browser."
  },
  {
   "fieldname": "capture",
   "fieldtype": "Select",
   "label": "Captured From",
   "options": "Browser\nVirtual meeting",
   "default": "Browser",
   "description": "Virtual meeting: recorded from class meetings the instructor names on each section, not by students in their browser."
  },
  {
   "depends_on": "eval:doc.mode=='Conversation'",
   "fieldname": "group_size",
   "fieldtype": "Int",
   "label": "Group Size",
   "non_negative": 1,
   "description": "On a section without student groups, groups of this size are made the first time the activity is opened. Leave 0 to let students choose classmates from the whole section."
  },
  {
   "fieldname": "section_break_prompt",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "prompt",
   "fieldtype": "Text Editor",
   "label": "Prompt"
  },
  {
   "description": "Steps run on each recording, from those the school allows. Stored as a list.",
   "fieldname": "oral_steps",
   "fieldtype": "Small Text",
   "label": "Processing Steps"
  },
  {
   "fieldname": "rubric",
   "fieldtype": "Link",
   "label": "Rubric",
   "options": "Rubric",
   "read_only": 1,
   "description": "The current version of this activity's rubric. Set from the activity's page in the portal."
  },
  {
   "fieldname": "peer_work_section",
   "fieldtype": "Section Break",
   "label": "Group Work, Topics and Peer Review",
   "collapsible": 1
  },
  {
   "fieldname": "group_source",
   "fieldtype": "Select",
   "label": "Groups",
   "options": "\nSection groups\nBy hand\nRandom\nSelf sign-up",
   "depends_on": "eval:doc.mode=='Conversation'",
   "description": "Section groups copies the section's student groups when the activity opens. Random uses the group size."
  },
  {
   "fieldname": "topic_mode",
   "fieldtype": "Select",
   "label": "Topics",
   "options": "\nBy hand\nRandom\nStudents choose",
   "description": "Leave blank for no topics. Each section lists its own topics."
  },
  {
   "fieldname": "column_break_peer_work",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "peer_review",
   "fieldtype": "Check",
   "label": "Peer Review"
  },
  {
   "fieldname": "reviews_per_student",
   "fieldtype": "Int",
   "label": "Reviews per Student",
   "default": "2",
   "depends_on": "peer_review"
  },
  {
   "fieldname": "review_opens",
   "fieldtype": "Select",
   "label": "Reviews Open",
   "options": "At the due date\nAt the cut-off\nBy hand",
   "default": "At the due date",
   "depends_on": "peer_review"
  },
  {
   "fieldname": "review_due_days",
   "fieldtype": "Int",
   "label": "Days to Review",
   "default": "7",
   "description": "Days after reviews open until reviews and ratings are due."
  },
  {
   "fieldname": "review_anonymous",
   "fieldtype": "Check",
   "label": "Anonymous Reviews",
   "depends_on": "peer_review"
  },
  {
   "fieldname": "review_form",
   "fieldtype": "Select",
   "label": "Review Form",
   "options": "Rubric\nComments only",
   "default": "Rubric",
   "depends_on": "peer_review"
  },
  {
   "fieldname": "teammate_ratings",
   "fieldtype": "Check",
   "label": "Teammate Ratings",
   "depends_on": "eval:doc.mode=='Conversation'",
   "description": "After the due date each member rates every other member of their group."
  },
  {
   "fieldname": "ratings_shown",
   "fieldtype": "Select",
   "label": "Ratings Shown",
   "options": "Named\nAnonymous\nInstructor only",
   "default": "Named",
   "depends_on": "teammate_ratings"
  },
  {
   "fieldname": "review_share",
   "fieldtype": "Percent",
   "label": "Review Share of the Grade",
   "depends_on": "eval:doc.peer_review || doc.teammate_ratings",
   "description": "The part of the grade earned by completing the assigned reviews and ratings on time."
  }
 ],
