{
 "actions": [],
 "allow_rename": 1,
 "autoname": "format:{coursecode}-{title}-{###}",
 "creation": "2025-03-07 09:06:43.140515",
 "description": "Assignment an instructor sets for a course, including the instructions, the accepted submission format, and whether it is graded. Create one for each assignment students will turn in.",
 "doctype": "DocType",
 "documentation": "https://docs.seminaryerp.org/modules/grading.html#assignment",
 "engine": "InnoDB",
 "field_order": [
  "assignment_section",
  "title",
  "course",
  "coursecode",
  "question",
  "type",
  "show_answer",
  "grade_assignment",
  "answer",
  "rubric",
  "defense_section",
  "oral_defense",
  "defense_questions",
  "defense_answer_s",
  "defense_follow_up",
  "column_break_defense",
  "defense_window",
  "defense_review",
  "defense_steps",
  "peer_work_section",
  "group_work",
  "group_source",
  "group_size",
  "topic_mode",
  "column_break_peer_work",
  "peer_review",
  "reviews_per_student",
  "review_opens",
  "review_due_days",
  "review_anonymous",
  "review_form",
  "teammate_ratings",
  "ratings_shown",
  "review_share"
 ],
 "fields": [
  {
   "description": "Assignment activities are to be submitted on the LMS",
   "fieldname": "assignment_section",
   "fieldtype": "Section Break",
   "label": "Assignment"
  },
  {
   "allow_in_quick_entry": 1,
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "reqd": 1
  },
  {
   "allow_in_quick_entry": 1,
   "fieldname": "question",
   "fieldtype": "Text Editor",
   "label": "Instructions"
  },
  {
   "allow_in_quick_entry": 1,
   "fieldname": "type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Accepted file type",
   "options": "PDF\nDocument\nImage\nURL\nText\nYouTube",
   "reqd": 1
  },
  {
   "default": "0",
   "fieldname": "show_answer",
   "fieldtype": "Check",
   "label": "Show Answer",
   "permlevel": 1
  },
  {
   "default": "1",
   "fieldname": "grade_assignment",
   "fieldtype": "Check",
   "label": "Grade Assignment"
  },
  {
   "fieldname": "answer",
   "fieldtype": "Text Editor",
   "label": "Correct Answer for Feedback",
   "permlevel": 1
  },
  {
   "fieldname": "course",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Course",
   "link_filters": "[[\"Course\",\"disabled\",\"=\",0]]",
   "options": "Course",
   "reqd": 1
  },
  {
   "fetch_from": "course.coursecode",
   "fieldname": "coursecode",
   "fieldtype": "Data",
   "is_virtual": 1,
   "label": "Course Code"
  },
  {
   "fieldname": "rubric",
   "fieldtype": "Link",
   "label": "Rubric",
   "options": "Rubric",
   "read_only": 1,
   "description": "The current version of this activity's rubric. Set from the activity's page in the portal."
  },
  {
   "fieldname": "defense_section",
   "fieldtype": "Section Break",
   "label": "Oral Defense",
   "collapsible": 1,
   "depends_on": "eval:['PDF','Document','Text'].includes(doc.type)"
  },
  {
   "default": "0",
   "fieldname": "oral_defense",
   "fieldtype": "Check",
   "label": "Oral Defense",
   "description": "After submitting, the student answers a few questions about the paper aloud. Only for PDF, Document and Text assignments."
  },
  {
   "default": "3",
   "depends_on": "eval:doc.oral_defense",
   "fieldname": "defense_questions",
   "fieldtype": "Int",
   "label": "Questions",
   "non_negative": 1
  },
  {
   "default": "120",
   "depends_on": "eval:doc.oral_defense",
   "fieldname": "defense_answer_s",
   "fieldtype": "Int",
   "label": "Seconds per Answer",
   "non_negative": 1
  },
  {
   "default": "0",
   "depends_on": "eval:doc.oral_defense",
   "fieldname": "defense_follow_up",
   "fieldtype": "Check",
   "label": "Ask a Follow-up Question",
   "description": "After each answer, one more question on what the student just said, when it can be written within 20 seconds."
  },
  {
   "fieldname": "column_break_defense",
   "fieldtype": "Column Break"
  },
  {
   "default": "259200",
   "depends_on": "eval:doc.oral_defense",
   "fieldname": "defense_window",
   "fieldtype": "Duration",
   "label": "Defense Due Within",
   "description": "Counted from when the defense opens: an hour for a defense straight after the paper, or days for one taken later."
  },
  {
   "default": "0",
   "depends_on": "eval:doc.oral_defense",
   "fieldname": "defense_review",
   "fieldtype": "Check",
   "label": "Review Questions Before the Defense Opens",
   "description": "The defense waits until you release its questions; the time to answer counts from then."
  },
  {
   "depends_on": "eval:doc.oral_defense",
   "fieldname": "defense_steps",
   "fieldtype": "Small Text",
   "label": "Processing Steps for Answers",
   "description": "Steps run on each recorded answer, from those the school allows. Stored as a list."
  },
  {
   "fieldname": "peer_work_section",
   "fieldtype": "Section Break",
   "label": "Group Work, Topics and Peer Review",
   "collapsible": 1
  },
  {
   "fieldname": "group_work",
   "fieldtype": "Check",
   "label": "Group Work",
   "description": "Each group hands in one piece of work, graded once for every member."
  },
  {
   "fieldname": "group_source",
   "fieldtype": "Select",
   "label": "Groups",
   "options": "\nSection groups\nBy hand\nRandom\nSelf sign-up",
   "depends_on": "eval:doc.group_work",
   "description": "Section groups copies the section's student groups when the activity opens. Random uses the group size."
  },
  {
   "fieldname": "group_size",
   "fieldtype": "Int",
   "label": "Group Size",
   "depends_on": "eval:doc.group_work && ['Random','Self sign-up'].includes(doc.group_source)",
   "description": "The size of random groups, or the most students a self sign-up group takes."
  },
  {
   "fieldname": "topic_mode",
   "fieldtype": "Select",
   "label": "Topics",
   "options": "\nBy hand\nRandom\nStudents choose",
   "description": "Leave blank for no topics. Each section lists its own topics."
  },
  {
   "fieldname": "column_break_peer_work",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "peer_review",
   "fieldtype": "Check",
   "label": "Peer Review"
  },
  {
   "fieldname": "reviews_per_student",
   "fieldtype": "Int",
   "label": "Reviews per Student",
   "default": "2",
   "depends_on": "peer_review"
  },
  {
   "fieldname": "review_opens",
   "fieldtype": "Select",
   "label": "Reviews Open",
   "options": "At the due date\nAt the cut-off\nBy hand",
   "default": "At the due date",
   "depends_on": "peer_review"
  },
  {
   "fieldname": "review_due_days",
   "fieldtype": "Int",
   "label": "Days to Review",
   "default": "7",
   "description": "Days after reviews open until reviews and ratings are due."
  },
  {
   "fieldname": "review_anonymous",
   "fieldtype": "Check",
   "label": "Anonymous Reviews",
   "depends_on": "peer_review"
  },
  {
   "fieldname": "review_form",
   "fieldtype": "Select",
   "label": "Review Form",
   "options": "Rubric\nComments only",
   "default": "Rubric",
   "depends_on": "peer_review"
  },
  {
   "fieldname": "teammate_ratings",
   "fieldtype": "Check",
   "label": "Teammate Ratings",
   "depends_on": "eval:doc.group_work",
   "description": "After the due date each member rates every other member of their group."
  },
  {
   "fieldname": "ratings_shown",
   "fieldtype": "Select",
   "label": "Ratings Shown",
   "options": "Named\nAnonymous\nInstructor only",
   "default": "Named",
   "depends_on": "teammate_ratings"
  },
  {
   "fieldname": "review_share",
   "fieldtype": "Percent",
   "label": "Review Share of the Grade",
   "depends_on": "eval:doc.peer_review || doc.teammate_ratings",
   "description": "The part of the grade earned by completing the assigned reviews and ratings on time."
  }
 ],
 "index_web_pages_for_search": 1,
